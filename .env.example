# ==============================================================================
# FAMOUS LETTERPRESS — ENVIRONMENT VARIABLES
# ==============================================================================

# Database (PostgreSQL / Supabase / Neon / Vercel Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/famous_letterpress?schema=public"

# Razorpay Payments (Live / Test Credentials)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Admin Authentication
ADMIN_SECRET_TOKEN="flp_super_secret_admin_token_2026"
NEXTAUTH_SECRET="your_nextauth_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# Media Storage (Cloudinary or S3-compatible image CDN)
CLOUDINARY_CLOUD_NAME="famous-letterpress"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"

# Transactional Email (Resend / SendGrid / Postmark)
RESEND_API_KEY="re_placeholder"
STUDIO_NOTIFICATION_EMAIL="hello@famousletterpress.com"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://famousletterpress.com"
